{
  "name": "fortschritt-healthcare",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Fortschritt Healthcare",
  "scripts": {
    "dev:clean": "concurrently --names \"FRONTEND,BACKEND\" -c \"magenta,cyan\" \"pnpm --filter frontend run dev\" \"pnpm --filter backend run dev\"",
    "dev": "bash scripts/dev.sh",
    "dev:terms": "bash scripts/dev.sh --terms",
    "build": "pnpm -r run build",
    "start": "pnpm -r run start"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
